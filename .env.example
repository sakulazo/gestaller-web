# Copia este fichero a .env y ajusta los valores (no versiones .env)

# URL base de la API del backend (usada en producción/build; en dev el proxy
# de Vite redirige /api y esta variable no es necesaria)
VITE_API_URL=http://localhost:8000

# Destino del proxy /api en desarrollo (solo afecta a vite.config.ts)
VITE_DEV_PROXY_TARGET=http://localhost:8000

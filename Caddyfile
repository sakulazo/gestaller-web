# Gestaller — Caddyfile de producción.
#
# Sirve la SPA compilada y hace de reverse proxy de /api hacia el backend
# (nombre de servicio `api` en la red Docker compartida gestaller-prod).
#
# PUBLIC_HOST es el dominio público que apunta al VPS (obligatorio): Caddy
# emite el certificado Let's Encrypt automáticamente y redirige http→https.
# El puerto 80 se expone para el reto HTTP-01 de emisión/renovación.
{$PUBLIC_HOST} {
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}